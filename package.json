{
  "name": "tracey-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @ggx/tracey-web dev",
    "build": "pnpm --filter @ggx/tracey-web build && pnpm --filter @ggx/tracey-cli build",
    "preview": "pnpm --filter @ggx/tracey-web preview",
    "tracey": "pnpm --filter @ggx/tracey-cli build >/dev/null && node apps/cli/bin/tracey.js",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
