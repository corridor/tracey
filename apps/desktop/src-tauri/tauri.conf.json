{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tracey",
  "version": "0.0.0",
  "identifier": "ai.genguardx.tracey",
  "build": {
    "beforeDevCommand": "pnpm --filter @ggx/tracey-web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @ggx/tracey-web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "tracey",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; worker-src 'self' blob:",
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "See what your AI agent really did",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      { "ext": ["jsonl", "json"], "name": "Agent trace", "description": "AI agent trace (OTLP JSON, Claude Code transcript)", "role": "Viewer", "mimeType": "application/json" }
    ]
  }
}
